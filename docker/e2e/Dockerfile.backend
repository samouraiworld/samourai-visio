FROM python:3.13.5-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /bin/
RUN apt-get update && apt-get install --yes --no-install-recommends libmagic1 \
    && rm -rf /var/lib/apt/lists/*
ENV UV_PYTHON_DOWNLOADS=0 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /app
COPY src/backend/pyproject.toml src/backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-install-project --all-extras
COPY src/backend /app
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --all-extras
ENV PATH="/app/.venv/bin:$PATH"

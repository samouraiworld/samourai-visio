# Copy to `deploy/.env` (compose reads this for ${VAR} interpolation).
#
# Clerk replaces Keycloak, so KEYCLOAK_HOST and REALM_NAME from the upstream
# template are unused and omitted.

MEET_HOST=visio.samourai.app
LIVEKIT_HOST=livekit.samourai.app

BACKEND_INTERNAL_HOST=backend
FRONTEND_INTERNAL_HOST=frontend
LIVEKIT_INTERNAL_HOST=livekit

# The subnet of the external `proxy-tier` Docker network (RUNBOOK §5): the only
# peers whose X-Forwarded-For the gateway trusts, so the flood brake and the
# access log see the real client rather than nginx-proxy. Read it on the host,
# never guess or widen it — preflight refuses a catch-all and any value that is
# not that network's own subnet:
#   docker network inspect proxy-tier -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# While it is unset, every compose command refuses to run.
PROXY_TIER_SUBNET=<proxy-tier-subnet>

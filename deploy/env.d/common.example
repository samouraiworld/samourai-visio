# visio.samourai.app — Meet backend config
# Copy to `env.d/common`, fill the <placeholders>, never commit the result.
#
# Derived from suitenumerique/meet env.d/production.dist/common (MIT, DINUM).
#
# ─── READ THIS BEFORE EDITING ───────────────────────────────────────────────
# List-valued settings are COMMA-SEPARATED. They are NOT JSON.
# `values.ListValue` parses with `value.strip().split(',')`
# (django-configurations configurations/values.py:238) and never reads JSON.
#
#     OIDC_USERINFO_FULLNAME_FIELDS=["given_name","family_name"]
#         -> ['["given_name"', '"family_name"]']   every display name is empty
#     OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
#         -> ['given_name', 'family_name']         correct
#
# There is no error and no warning. Upstream's own production template gets
# this wrong at env.d/production.dist/common:44.
# ────────────────────────────────────────────────────────────────────────────
#
# Differs from upstream in five deliberate places:
#   1. OIDC points at our realm `samourai-app` at auth.kodera.io, client
#      `visio` (upstream points at its own Keycloak through KEYCLOAK_HOST)
#   2. OIDC_RP_SCOPES adds `profile`   (default "openid email" -> names empty)
#   3. OIDC_USERINFO_FULLNAME_FIELDS overridden (default contains `usual_name`,
#      a ProConnect-only claim Keycloak does not emit)
#   4. ALLOW_UNREGISTERED_ROOMS=True   (upstream template ships False, which
#      would require an account just to JOIN a call)
#   5. FRONTEND_IS_SILENT_LOGIN_ENABLED=false (a guest never contacts the
#      identity provider; see Guest access below)

# ── Django ──
DJANGO_ALLOWED_HOSTS=${MEET_HOST}
# NOTE: `openssl rand -base64 64` wraps at 64 columns and emits TWO lines.
# Pasted here, the key is truncated at the wrap and the remainder becomes a
# junk variable — silently. Generate with:  openssl rand -base64 64 | tr -d '\n'
DJANGO_SECRET_KEY=<openssl rand -base64 64 | tr -d '\n'>
DJANGO_SETTINGS_MODULE=meet.settings
DJANGO_CONFIGURATION=Production
PYTHONPATH=/app
MEET_BASE_URL="https://${MEET_HOST}"

# BACKEND default locale. Upstream defaults to `en-us` (settings.py:217).
# `LANGUAGE_CODE` carries no environ_name override, so it takes the default
# DJANGO_ prefix. Supported: en-us, fr-fr, nl-nl, de-de (settings.py:227-234)
# — anything else falls back without an error.
#
# What this does NOT do — verified against the v1.24.0 bundle:
#   * It does not set the INTERFACE language. The frontend resolves that
#     client-side with i18next browser detection (order: localStorage then
#     navigator, fallbackLng 'fr'); LANGUAGE_CODE appears in none of the JS
#     chunks. A visitor with an en-US browser sees English whatever you set.
#   * It does not force invitation e-mails to French. LocaleMiddleware plus
#     invitation.py's get_language() mean the SENDER's Accept-Language wins;
#     this value is only the last-resort fallback.
# It does set the default User.language and that fallback, so it is still
# the right value for a French service — just not a switch for the UI.
DJANGO_LANGUAGE_CODE=fr-fr

# Empty by default in Production. Same-origin POSTs pass on host comparison,
# so this is normally unnecessary. Uncomment only if login POSTs 403.
# Comma-separated WITH scheme (this one is compared against the Origin header).
#DJANGO_CSRF_TRUSTED_ORIGINS=https://visio.samourai.app

# ── Mail — Scaleway Transactional Email (TEM) ──
# French provider (Paris / fr-par, EU data residency), same account as the
# instance. Chosen over US-based Resend for sovereignty.
# SMTP username = the Project ID of the Project that owns the TEM domain.
# SMTP password = the SECRET KEY of an API key in that Project (with TEM rights).
# Requires the sending domain verified in TEM first (SPF + DKIM + DMARC records).
# Docs: https://www.scaleway.com/en/docs/transactional-email/reference-content/smtp-configuration/
DJANGO_EMAIL_HOST=smtp.tem.scaleway.com
DJANGO_EMAIL_HOST_USER=<Scaleway Project ID>
DJANGO_EMAIL_HOST_PASSWORD=<Scaleway API secret key with TEM permission>
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_FROM=visio@samourai.app
DJANGO_EMAIL_BRAND_NAME="Samouraï Visio"
# Served by the ./custom bind-mount in compose.override.yaml. Without it this
# 404s in every invitation email — and the SPA fallback returns 200 text/html
# rather than a 404, so a naive curl check will not catch it.
DJANGO_EMAIL_LOGO_IMG="https://${MEET_HOST}/custom/logo.png"

# ── OIDC — realm samourai-app at auth.kodera.io, client visio ──
# Issuer https://auth.kodera.io/realms/samourai-app. Accounts are created at
# first sign-in through GitHub or Google; no password is ever set.
# Meet checks neither `iss` nor `aud` on the ID token: it trusts any token
# signed by a key behind OIDC_OP_JWKS_ENDPOINT. These lines are therefore the
# whole trust decision, and `preflight.sh config` pins each one to the realm
# and compares them with the realm's live discovery document.
# Never delete a line: unset, Django falls back to None and every request
# carrying a session cookie fails with ImproperlyConfigured.
# Never re-create the old CNAME clerk.samourai.app -> frontend-api.clerk.services.
OIDC_OP_JWKS_ENDPOINT=https://auth.kodera.io/realms/samourai-app/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.kodera.io/realms/samourai-app/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=https://auth.kodera.io/realms/samourai-app/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https://auth.kodera.io/realms/samourai-app/protocol/openid-connect/userinfo
# RP-initiated logout: "Se déconnecter" ends the Keycloak session as well,
# so on a shared computer the next "Se connecter" asks again. It needs the
# ID token in the session (OIDC_STORE_ID_TOKEN below) as id_token_hint;
# django-lasuite oidc_login/views.py:89-107.
OIDC_OP_LOGOUT_ENDPOINT=https://auth.kodera.io/realms/samourai-app/protocol/openid-connect/logout

# Confidential client `visio`: exact redirect URI
# https://visio.samourai.app/api/v1.0/callback/ (trailing slash included),
# post-logout URI https://visio.samourai.app/api/v1.0/logout-callback/.
# The secret is on the client's Credentials tab in Keycloak; it lives there
# and in this file only. Set it here OR through OIDC_RP_CLIENT_SECRET_FILE
# (footer), never both: the file wins silently.
OIDC_RP_CLIENT_ID=visio
OIDC_RP_CLIENT_SECRET=<from Keycloak: client visio, Credentials tab>
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"

# Comma-separated, NOT JSON. See the header.
# Keycloak emits given_name and family_name from the account's first and last
# name, which GitHub and Google fill at first sign-in; the realm requires a
# first name, so given_name is never empty.
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
OIDC_USERINFO_SHORTNAME_FIELD=given_name
# Default is empty, which requires only `sub` — so an identity with no email
# would create a silent null-email account rather than being rejected.
OIDC_USERINFO_ESSENTIAL_CLAIMS=email

OIDC_USE_PKCE=true
OIDC_PKCE_CODE_CHALLENGE_METHOD=S256
OIDC_CREATE_USER=true
OIDC_REDIRECT_REQUIRE_HTTPS=true
# Host only — no scheme, no brackets. Django compares urlparse(url).netloc
# against this set, so a scheme-bearing entry can never match anything.
OIDC_REDIRECT_ALLOWED_HOSTS=visio.samourai.app
# Kept in the Redis session for RP-initiated logout only (see above): without
# it, logout ends the Visio session and leaves the Keycloak one open.
OIDC_STORE_ID_TOKEN=true

# NEVER set OIDC_FALLBACK_TO_EMAIL_FOR_IDENTIFICATION=true. `email_verified`
# is checked nowhere in the chain, so in a realm shared with other apps it
# creates an account-takeover path via an unverified email matching an
# existing user. Users are matched on `sub` alone.

LOGIN_REDIRECT_URL=https://${MEET_HOST}
LOGIN_REDIRECT_URL_FAILURE=https://${MEET_HOST}
LOGOUT_REDIRECT_URL=https://${MEET_HOST}

# ── LiveKit ──
LIVEKIT_API_SECRET=<openssl rand -base64 48>
LIVEKIT_API_KEY=meet
LIVEKIT_API_URL=https://${LIVEKIT_HOST}
# Browsers need wss://, not https://. Upstream's own production Helm values
# set this true while the code default is false; the docs and code disagree.
LIVEKIT_FORCE_WSS_PROTOCOL=true

# ── Public instance ──
# Code default is True (settings.py:665); the upstream production template
# ships False and the env file wins. Both statements are true, about
# different layers.
#
# What it actually does (core/api/viewsets.py:257-277): it fires ONLY when
# RoomViewSet.retrieve raises Http404 — a slug NOT in the database — and then
# returns a synthetic public room plus a LiveKit token. It grants ad-hoc rooms
# conjured from a URL. It has no effect on rooms that already exist, so an
# account is NOT required to create a working room, only to own an
# administrable one.
ALLOW_UNREGISTERED_ROOMS=True

# ── Guest access (product requirement: usable without an account) ──
# This is already satisfied by ALLOW_UNREGISTERED_ROOMS above plus the join
# screen: Join.tsx:457 renders a required name field whenever the visitor is
# not logged in, and passes it as ?username= to the room endpoint. A guest
# types a name and joins. No account, no e-mail, nothing to verify.
#
# Note this is MORE open than Google Meet, which requires an account to create
# a meeting. Here an unauthenticated visitor can conjure a working room from
# any URL. The trade is that such rooms have no owner, no admin controls
# (is_administrable: false) and no attribution for moderation.
#
# DISABLED deliberately (decision 2026-07-24). Upstream defaults to true, which
# sends EVERY anonymous visitor to the identity provider with prompt=none
# before they click anything — a round trip on the guest path, on a service
# whose stated position is that a guest leaves no trace. Verified live before
# the change: an anonymous visit left `silent-login-retry` in localStorage,
# i.e. it fired.
#
# With this false, a guest's browser never contacts auth.kodera.io at all,
# which is what lets the privacy policy state it plainly
# (landing/confidentialite/).
#
# Cost: a Samouraï user already signed in elsewhere must click "se connecter"
# instead of being recognised silently. Accepted.
# Bonus: the callback only handles error=login_required gracefully — anything
# else (interaction_required, consent_required) landed in login_failure, so
# this also removes a bounce risk from every first-time guest.
FRONTEND_IS_SILENT_LOGIN_ENABLED=false

# ── Branding ──
# The setting is FRONTEND_CUSTOM_CSS_URL. FRONTEND_CSS_URL does not exist, and
# Django ignores unknown env vars silently — a wrong name here yields a
# perfectly healthy stack with no theme and no error anywhere.
FRONTEND_CUSTOM_CSS_URL=/custom/style.css
# Leave false. Enabling it renders the French Republic footer and loads
# /assets/marianne.svg and /assets/devise.svg, which are not in the image.
#FRONTEND_USE_FRENCH_GOV_FOOTER=false

# ── Public landing page ──
# Sends ANONYMOUS visitors who land on `/` to our own home page. Signed-in
# users keep Meet's home (create instant / scheduled room), and rooms
# (/<slug>) are never affected — this is the upstream-supported way to put a
# custom front door on the service without forking the frontend.
#
# Mechanism: settings.py:401 -> /api/v1.0/config/ -> Home.tsx does a HEAD
# probe, then window.location.replace(). Because the probe must succeed, the
# URL has to be reachable from the visitor's browser — keep it same-origin.
#
# Served by the ./landing bind-mount in compose.override.yaml. Same silent
# failure as the CSS: the frontend nginx does `error_page 404 =200 /index.html`,
# so a missing mount returns 200 text/html (the SPA) rather than a 404, and
# the redirect would land the visitor back on the app looking like a loop.
# Trailing slash matters — without it nginx issues an extra 301.
# Unset it to restore upstream's own home page.
FRONTEND_EXTERNAL_HOME_URL="https://${MEET_HOST}/accueil/"

# ── Monitoring ──
# The name to use is DJANGO_SENTRY_DSN. The bare SENTRY_DSN does NOTHING.
#
# This corrects the inverted note this file carried until 2026-07-25 (and the
# matching roadmap line). settings.py:448 declares
#   SENTRY_DSN = values.Value(None, environ_name="SENTRY_DSN")
# and `environ_name` does NOT suppress the DJANGO_ prefix — only
# `environ_prefix=None` does, which upstream passes elsewhere (settings.py:82,
# 92, 103) but not here. Tested against upstream's own pin,
# django-configurations==2.5.1:
#   DJANGO_SENTRY_DSN=x                      -> 'x'   (works)
#   SENTRY_DSN=x                             -> None  (ignored silently)
#   SENTRY_DSN=x with environ_prefix=None    -> 'x'   (control)
# So settings.py:69's docstring is right and upstream's own kubernetes.md
# documents the dead bare name. Getting this backwards means a DSN that is
# accepted, never used, and never warns — no errors reach Sentry and nothing
# says so. preflight.sh fails on the bare form for that reason.
#DJANGO_SENTRY_DSN=<from sentry.samourai.pro>

# ── File-based secrets (recommended) ──
# SECRET_KEY, OIDC_RP_CLIENT_SECRET, EMAIL_HOST_PASSWORD, DB_PASSWORD and the
# LiveKit key/secret are all SecretFileValue: each accepts a `<VAR>_FILE`
# variant that is read from disk and takes precedence over the plain variable.
# This keeps secrets out of the process environment and out of
# `docker compose config` output.
#
#   DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
#   OIDC_RP_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
#   DJANGO_EMAIL_HOST_PASSWORD_FILE=/run/secrets/scaleway_tem_secret_key
#
# Write them with `printf '%s'` — exactly one trailing newline is stripped, so
# a trailing blank line corrupts the secret. A missing path raises at settings
# import, so the container dies loudly rather than starting misconfigured.

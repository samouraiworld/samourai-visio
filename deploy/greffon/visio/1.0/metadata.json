{
  "name": "Samouraï Visio",
  "min_greffer_version": "0.3.3",
  "logo": "https://raw.githubusercontent.com/samouraiworld/samourai-visio/main/theme/icons/android-chrome-512x512.png",
  "description": "Free video conferencing by Samouraï Coop — La Suite Meet (DINUM), themed and authenticated against the Samouraï Clerk SSO. Guests join by link with no account. WebRTC media uses one UDP port published on the host. Requires: a Clerk OAuth application whose redirect URI is set to {{ instance_url }}/api/v1.0/callback/, and this instance bound to a stable domain. No recording in v1.",
  "categories": [
    "productivity",
    "collaboration"
  ],
  "images": [],
  "ports": [
    {
      "name": "gateway_8083",
      "exposure_tier": "http",
      "protocol": "tcp"
    },
    {
      "name": "livekit_7882",
      "exposure_tier": "l4",
      "protocol": "udp",
      "same_port": true,
      "udp_reviewed": true
    }
  ],
  "configurations": [
    {
      "title": "Gateway routing config",
      "schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "data-url",
            "title": "nginx gateway default.conf"
          }
        },
        "x-greffon-visibility": "hidden"
      },
      "default_value": {
        "file": "data:text/plain;base64,"
      },
      "destinations": [
        {
          "type": "file",
          "volume": "gateway_conf",
          "name": "default.conf"
        }
      ]
    },
    {
      "title": "LiveKit config",
      "schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "data-url",
            "title": "livekit.yaml"
          }
        },
        "x-greffon-visibility": "hidden"
      },
      "default_value": {
        "file": "data:text/plain;base64,"
      },
      "destinations": [
        {
          "type": "file",
          "volume": "livekit_conf",
          "name": "livekit.yaml",
          "x-greffon-render": true
        }
      ]
    },
    {
      "title": "Samouraï theme",
      "schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "data-url",
            "title": "custom style.css"
          }
        },
        "x-greffon-visibility": "hidden"
      },
      "default_value": {
        "file": "data:text/css;base64,"
      },
      "destinations": [
        {
          "type": "file",
          "volume": "frontend_custom",
          "name": "style.css"
        }
      ]
    },
    {
      "title": "Django secret key",
      "schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "title": "Django secret key",
            "writeOnly": true,
            "minLength": 50,
            "format": "greffon-secret"
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "backend",
          "key": "DJANGO_SECRET_KEY"
        }
      ]
    },
    {
      "title": "Database password",
      "schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "title": "Database password",
            "writeOnly": true,
            "minLength": 24,
            "format": "greffon-secret"
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "backend",
          "key": "DB_PASSWORD"
        },
        {
          "type": "env",
          "container": "postgresql",
          "key": "POSTGRES_PASSWORD"
        }
      ]
    },
    {
      "title": "LiveKit API secret",
      "schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "title": "LiveKit API secret",
            "writeOnly": true,
            "minLength": 32,
            "format": "greffon-secret"
          }
        },
        "x-greffon-visibility": "advanced"
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "backend",
          "key": "LIVEKIT_API_SECRET"
        }
      ]
    },
    {
      "title": "Clerk client ID",
      "schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "title": "Clerk client ID",
            "description": "From the Clerk OAuth application. Register redirect URI {{ instance_url }}/api/v1.0/callback/ and scopes 'openid email profile'."
          }
        },
        "x-greffon-visibility": "visible"
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "backend",
          "key": "OIDC_RP_CLIENT_ID"
        }
      ]
    },
    {
      "title": "Clerk client secret",
      "schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "title": "Clerk client secret",
            "description": "Shown once in the Clerk dashboard when the OAuth app is created.",
            "writeOnly": true
          }
        },
        "x-greffon-visibility": "visible"
      },
      "default_value": {
        "value": ""
      },
      "destinations": [
        {
          "type": "env",
          "container": "backend",
          "key": "OIDC_RP_CLIENT_SECRET"
        }
      ]
    },
    {
      "title": "SMTP",
      "schema": {
        "type": "object",
        "properties": {}
      },
      "default_value": {},
      "destinations": [
        {
          "type": "smtp",
          "container": "backend",
          "key": "DJANGO_EMAIL_HOST"
        },
        {
          "type": "smtp",
          "container": "backend",
          "key": "DJANGO_EMAIL_PORT"
        },
        {
          "type": "smtp",
          "container": "backend",
          "key": "DJANGO_EMAIL_HOST_USER"
        },
        {
          "type": "smtp",
          "container": "backend",
          "key": "DJANGO_EMAIL_HOST_PASSWORD"
        },
        {
          "type": "smtp",
          "container": "backend",
          "key": "DJANGO_EMAIL_FROM"
        },
        {
          "type": "smtp",
          "container": "backend",
          "key": "DJANGO_EMAIL_USE_TLS"
        },
        {
          "type": "smtp",
          "container": "backend",
          "key": "DJANGO_EMAIL_USE_SSL"
        }
      ]
    }
  ]
}

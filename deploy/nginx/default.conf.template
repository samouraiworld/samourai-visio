# SAMOURAI-BEGIN provenance
# Verbatim copy of upstream docker/files/production/default.conf.template at
# v1.24.0, plus the blocks between SAMOURAI-BEGIN/END markers. It replaces the
# host-fetched copy through the compose.override.yaml mount (same target path
# — compose replaces volumes keyed by target), because upstream's SPA
# hardcodes DINUM's legal pages at /mentions-legales, /conditions-utilisation
# and /accessibilite (src/frontend/src/routes.ts) and no env var disables
# them: they name the French State as publisher and describe a service
# reserved for State administrations. The redirect block below answers those
# routes before the SPA can.
#
# Drift control: check-upstream-contract.sh diffs this file, SAMOURAI blocks
# stripped, against upstream's copy at the pinned tag — the same regime as
# theme/custom.css against panda.config.ts. If that gate goes red on a
# version bump, re-derive this copy: fresh upstream file + these blocks.
#
# envsubst: the stock nginx entrypoint substitutes only ${VARS} that exist in
# the environment; nginx runtime vars ($http_host, $uri) survive. The added
# blocks read exactly one environment variable, PROXY_TIER_SUBNET, and every
# nginx variable they use has a name no environment variable carries.
# SAMOURAI-END

# SAMOURAI-BEGIN flood brake on anonymous token minting (zones)
# Two endpoints hand a LiveKit token to a caller who has no account (Meet
# v1.24.0, src/backend/core):
#   GET/HEAD /api/v1.0/rooms/<slug>/  RoomViewSet.retrieve (api/viewsets.py:257-
#       285). For a slug not in the database it answers a synthetic room and a
#       fresh token (ALLOW_UNREGISTERED_ROOMS) — room creation with no account;
#       for a public room the serializer mints one too (serializers.py:169-188).
#   POST /api/v1.0/rooms/<id>/request-entry/  RoomViewSet.request_entry
#       (api/viewsets.py:474-501, permission_classes=[]). LobbyService mints for
#       a public room on every call and for an admitted participant
#       (services/lobby.py:124-190).
# POST /api/v1.0/rooms/ requires an account (api/permissions.py:50-55);
# creation-callback returns a cached slug, never a token; the external API is
# off by default and this gateway does not proxy /external-api/ at all; and
# add-ons are off by default (ADDONS_ENABLED) and hand out no LiveKit token.
#
# Each shape is matched on what reaches Django, including DRF's format suffix
# (`rooms/<slug>.json` routes to retrieve with no slash — rest_framework
# urlpatterns.py:107-109). `rooms/<slug>` without a slash is NOT counted: Django
# answers it with a 301 and mints nothing, and the SPA requests exactly that
# form (fetchRoom.ts via apiUrl.ts), so counting it would bill every join twice.
# A request matching neither shape maps to "" and nginx does not count it:
# every other API call, and all media (LiveKit has its own vhost).
#
# The key is the client address after realip (server block below), prefixed by
# whether the request carries a session cookie. That is not "signed in": Django
# sets the cookie for anonymous visitors too — the login flow keeps its state
# in the session — and nginx cannot verify it. So it never exempts. It puts
# the request in a second bucket of the same size, braked the same way: a
# forged cookie only moves a client to the other bucket, and an anonymous flood
# from a shared address (a venue, a carrier NAT) cannot spend the joins of the
# requests from that address that do carry one.
map $cookie_meet_sessionid $visio_mint_tier {
    ""      anon:;
    default session:;
}
map "$request_method $uri" $visio_mint_room_key {
    default "";
    "~^(GET|HEAD) /api/v1\.0/rooms/[^/]+/$"       $visio_mint_tier$binary_remote_addr;
    "~^(GET|HEAD) /api/v1\.0/rooms/[^/]*\.[^/]*$" $visio_mint_tier$binary_remote_addr;
}
map "$request_method $uri" $visio_mint_lobby_key {
    default "";
    "~^POST /api/v1\.0/rooms/[^/]+/request-entry[^/]*/?$" $visio_mint_tier$binary_remote_addr;
}
limit_req_zone $visio_mint_room_key  zone=visio_mint_room:10m  rate=2r/s;
limit_req_zone $visio_mint_lobby_key zone=visio_mint_lobby:10m rate=30r/s;
# SAMOURAI-END

upstream meet_backend {
    server ${BACKEND_INTERNAL_HOST}:8000 fail_timeout=0;
}

upstream meet_frontend {
    server ${FRONTEND_INTERNAL_HOST}:8080 fail_timeout=0;
}

server {
    listen 8083;
    server_name localhost;
    charset utf-8;

    # Disables server version feedback on pages and in headers
    server_tokens off;

    proxy_ssl_server_name on;

    # SAMOURAI-BEGIN response headers
    # Only Strict-Transport-Security reached browsers before this block, and it
    # arrived TWICE: Django emits `max-age=60; includeSubDomains; preload` and
    # nginx-proxy adds `max-age=31536000`. RFC 6797 §8.1 says the UA processes
    # the FIRST header and ignores the rest, so the 60-second policy won —
    # HSTS effectively expired a minute after the last API call, while
    # advertising `preload`. Verified live 2026-07-25. Hide the upstream one in
    # the proxy blocks below and emit exactly one policy here.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # frame-ancestors, not X-Frame-Options: it is the standard, and CSP wins
    # where both are understood. TRADE-OFF: this blocks embedding in third-party
    # pages, which disables upstream's /sdk/create-popup and /sdk/create-button
    # embed routes. We do not use them; if that ever changes, relax this to a
    # per-location policy rather than dropping it wholesale.
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    # Room slugs ARE the access secret, so a full-URL Referer must never leave
    # this origin — a shared room link in a Referer header is a room invite.
    # `same-origin`, which is also what Django emits on every /api response
    # (SECURE_REFERRER_POLICY default). It used to be
    # `strict-origin-when-cross-origin` here, so /api carried BOTH values and
    # browsers took the last one — the looser one. One value, and the proxy
    # blocks below hide Django's copy so it is emitted exactly once. Nothing
    # the SPA talks to cross-origin reads Referer: CORS uses the Origin
    # header, the LiveKit websocket and the OIDC redirect carry their own
    # parameters.
    add_header Referrer-Policy "same-origin" always;
    # SAMOURAI-END

    # SAMOURAI-BEGIN real client address, and the flood brake applied
    # nginx-proxy is the only hop in front of this server, and it connects from
    # the external proxy-tier network. With TRUST_DOWNSTREAM_PROXY=false
    # (RUNBOOK §5) it sets X-Forwarded-For to the address it accepted the
    # connection from and discards whatever the client sent (nginx-proxy's
    # nginx.tmpl, `map $proxy_add_x_forwarded_for $proxy_x_forwarded_for`).
    #   - Trust that header only from PROXY_TIER_SUBNET, the subnet of that
    #     network, supplied on the host in .env. Never a literal here.
    #   - real_ip_recursive off: take the LAST address, the one nginx-proxy
    #     wrote. `on` walks left past trusted addresses into whatever a client
    #     wrote, the moment the trusted set is wider than it should be.
    # Unset, the variable survives envsubst as the literal ${PROXY_TIER_SUBNET}
    # and nginx refuses to start; compose refuses even earlier
    # (compose.override.yaml). Neither path trusts everyone.
    # After this, $remote_addr — the access log and the brake's key — is the
    # client, not nginx-proxy.
    set_real_ip_from ${PROXY_TIER_SUBNET};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    # The brake. Zones, and exactly what they count, are at the top of this
    # file. Per client address, per tier:
    #   room   2 r/s, burst 100. A join is ONE minting GET: Join.tsx fetches the
    #          room once on submit and Conference.tsx reuses that answer. So 100
    #          joins at the same instant from one address pass — the whole LT-7
    #          join storm (docs/LOAD_TEST.md) arriving from a single venue — and
    #          2 more a second after that. A 200-request burst gets 99 refusals,
    #          and scripted minting settles at 2 tokens a second per address.
    #   lobby  30 r/s, burst 60. A waiting participant polls once a second
    #          (useLobby.ts POLL_INTERVAL_MS) and falls out of the lobby after
    #          3 s without a poll (settings.py LOBBY_WAITING_TIMEOUT), so the
    #          rate carries a full room — room.max_participants, 30 — waiting
    #          behind one address. preflight fails if the cap outgrows it.
    # All four numbers are provisional until the load runs (#45, #46) measure
    # them; what a refused join looks like to a visitor, and what the brake
    # does not limit (media), are in RUNBOOK §5 and docs/LOAD_TEST.md.
    # nodelay: refuse at once rather than queue; a queued poll arrives late and
    # a queued flood still holds a connection. 429 rather than the default
    # 503: it says "slow down", and the runbook's verification counts it.
    limit_req zone=visio_mint_room burst=100 nodelay;
    limit_req zone=visio_mint_lobby burst=60 nodelay;
    limit_req_status 429;
    # SAMOURAI-END

    location @proxy_to_meet_backend {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # SAMOURAI-BEGIN single header set
        proxy_hide_header Strict-Transport-Security;
        # Django's SecurityMiddleware sets these two as well; without the
        # hides /api answered with each of them twice (verified live), and a
        # differing Referrer-Policy value let the looser one win.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        # SAMOURAI-END

        proxy_redirect off;
        proxy_pass http://meet_backend;
    }

    location @proxy_to_meet_frontend {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # SAMOURAI-BEGIN single header set
        proxy_hide_header Strict-Transport-Security;
        # Django's SecurityMiddleware sets these two as well; without the
        # hides /api answered with each of them twice (verified live), and a
        # differing Referrer-Policy value let the looser one win.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        # SAMOURAI-END

        proxy_redirect off;
        proxy_pass http://meet_frontend;
    }

    # SAMOURAI-BEGIN legal-page redirects
    # Exact-match locations take precedence over every prefix location, so
    # these fire before `location /` can hand the path to the SPA. 301, not
    # 302: these routes must never come back.
    #
    # absolute_redirect off makes every redirect this server emits (ours and
    # nginx's own slash-completions) a relative Location. The default would
    # build http:// URLs — this server listens in plaintext behind the
    # TLS-terminating proxy and would embed its own scheme.
    absolute_redirect off;

    # Slash-completion for our own pages, answered HERE rather than by the
    # frontend container. Verified live 2026-07-25: without these,
    # GET /accueil returned `301 Location: http://visio.samourai.app:8080/`
    # — the container's own redirect, built from its internal listen port and
    # plaintext scheme, leaking through `proxy_redirect off` (upstream's
    # verbatim block) to the public internet. The target is a firewalled port
    # over http: it simply times out. Anyone who types or links the URL
    # without the trailing slash lands on a dead page. `absolute_redirect off`
    # above only governs redirects THIS server generates, not proxied ones.
    location = /accueil { return 301 /accueil/; }
    location = /accueil/mentions-legales      { return 301 /accueil/mentions-legales/; }
    location = /accueil/confidentialite       { return 301 /accueil/confidentialite/; }
    location = /accueil/conditions-utilisation { return 301 /accueil/conditions-utilisation/; }

    location = /mentions-legales  { return 301 /accueil/mentions-legales/; }
    location = /mentions-legales/ { return 301 /accueil/mentions-legales/; }
    location = /conditions-utilisation  { return 301 /accueil/conditions-utilisation/; }
    location = /conditions-utilisation/ { return 301 /accueil/conditions-utilisation/; }
    # DINUM's RGAA accessibility declaration. Nothing equivalent exists for
    # this instance (the legal obligation does not reach Samouraï Coop), so
    # send it home rather than serve a declaration about someone else's
    # service.
    location = /accessibilite  { return 301 /accueil/; }
    location = /accessibilite/ { return 301 /accueil/; }
    # SAMOURAI-END

    # SAMOURAI-BEGIN admin not on the internet
    # The Django admin reaches every account and every room, and a successful
    # login can insert a ResourceAccess row granting roomAdmin on any room —
    # i.e. moderation control of a private meeting, bypassing Clerk entirely.
    # It ships no MFA and no brute-force protection (upstream carries neither
    # django-axes nor django-ratelimit), so a password created by hand during
    # a deploy is the weakest credential in the system while every real user
    # authenticates through Clerk.
    #
    # 404, not 403: a 403 confirms the endpoint exists.
    #
    # A REGEX location, deliberately. `location ^~ /admin` looks stronger but
    # is the same location KEY as upstream's `location /admin` further down
    # (the modifier is not part of the name), so nginx refuses to start with
    # "duplicate location" — caught by the nginx -t CI gate, which is the kind
    # of total outage that gate exists for. A regex is a distinct key and,
    # since upstream's is a plain prefix, the regex is matched first and wins.
    # `=` locations (our legal routes above) still take precedence over both.
    #
    # Reach it from the host instead, over an SSH tunnel:
    #   ssh -L 8000:localhost:8000 <host>
    #   docker compose exec backend python manage.py runserver 0.0.0.0:8000
    # or use `docker compose exec backend python manage.py shell` for one-offs.
    # To publish it deliberately, replace this block with an allow-list
    # (`allow <operator CIDR>; deny all;`) — never with nothing.
    location ~ ^/admin { return 404; }
    # SAMOURAI-END

    # SAMOURAI-BEGIN share cards: send crawlers to a page that describes US
    # `/` is upstream's SPA shell: <title>LaSuite Meet</title> and not one og
    # tag (verified live 2026-07-27). Anonymous humans never see it — the SPA
    # redirects them to /accueil/ via FRONTEND_EXTERNAL_HOME_URL — but a link
    # crawler does not run JavaScript, so every share of the bare domain was
    # unfurling as DINUM's product, with DINUM's icon.
    #
    # Crawlers DO follow redirects, so one server-side hop fixes it for every
    # platform at once, with no user-agent sniffing and no fork: the crawler
    # lands on /accueil/ and reads our og tags there.
    #
    # Gated on the session cookie so signed-in users keep Meet's own home — the
    # settled behaviour. Upstream names it meet_sessionid (settings.py:1198),
    # NOT Django's default `sessionid`; the wrong name here would send every
    # signed-in user to the landing page instead.
    #
    # Degrades safely: a stale cookie still reaches the SPA, which falls back
    # to its own JS redirect. no-store so a browser cannot cache the redirect
    # and keep bouncing a user who has since signed in.
    #
    # The four security headers are REPEATED inside the `if`: nginx inherits
    # add_header from the enclosing level only when the current level sets
    # none, and an `if` block is a level of its own. With Cache-Control alone
    # here, the 302 every cookieless visit to the bare domain receives shipped
    # no HSTS and no CSP at all (verified live). The values must stay
    # identical to the server-level block above; preflight asserts both.
    location = / {
        if ($cookie_meet_sessionid = "") {
            add_header Cache-Control "no-store" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Content-Security-Policy "frame-ancestors 'self'" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "same-origin" always;
            return 302 /accueil/;
        }
        try_files $uri @proxy_to_meet_frontend;
    }
    # SAMOURAI-END

    # SAMOURAI-BEGIN security.txt (RFC 9116) and the rest of /.well-known/
    # Answered here, from the template, so it needs no extra mount and gets
    # the server-level headers (this location sets no add_header of its own).
    # `Expires` is the one calendar date the RFC makes mandatory; keep it
    # under a year ahead and renew it — `preflight.sh public` goes red thirty
    # days before it lapses. Everything else under /.well-known/ is a 404:
    # the SPA fallback used to answer 200 text/html for any such path, which
    # made a missing security.txt look like a served one. ACME challenges are
    # unaffected — nginx-proxy answers /.well-known/acme-challenge/ itself
    # and never forwards them here.
    location = /.well-known/security.txt {
        default_type text/plain;
        return 200 "Contact: mailto:security@samourai.app\nExpires: 2027-09-01T00:00:00Z\nPreferred-Languages: fr, en\nCanonical: https://$http_host/.well-known/security.txt\n";
    }
    location /.well-known/ { return 404; }
    # SAMOURAI-END

    location / {
        try_files $uri @proxy_to_meet_frontend;
    }

    location /api {
        try_files $uri @proxy_to_meet_backend;
    }

    location /admin {
        try_files $uri @proxy_to_meet_backend;
    }

    location /static {
        try_files $uri @proxy_to_meet_backend;
    }
}